{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cyber-review/scope.schema.json",
  "type": "object",
  "required": [
    "schema",
    "origin",
    "method",
    "paths",
    "fixture_source_sha256",
    "profile_sha256",
    "expires_at",
    "request_credentials",
    "response_body_retained",
    "automatic_replay_allowed"
  ],
  "properties": {
    "schema": {
      "const": "cyber-review.scope.v1"
    },
    "origin": {
      "type": "string",
      "pattern": "^http://127\\.0\\.0\\.1:[1-9][0-9]{0,4}$"
    },
    "method": {
      "const": "HEAD"
    },
    "paths": {
      "const": [
        "/candidate/headers",
        "/candidate/restricted",
        "/clean_control/headers",
        "/clean_control/restricted"
      ]
    },
    "fixture_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expires_at": {
      "type": "integer"
    },
    "request_credentials": {
      "const": false
    },
    "response_body_retained": {
      "const": false
    },
    "automatic_replay_allowed": {
      "const": false
    }
  },
  "additionalProperties": false
}
